{
  "name": "muxplorer",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "scripts": {
    "build": "pnpm --filter @muxplorer/api build && pnpm --filter @muxplorer/web build",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "test": "pnpm --filter @muxplorer/api test",
    "typecheck": "pnpm --filter @muxplorer/api typecheck && pnpm --filter @muxplorer/web typecheck",
    "lint": "eslint apps packages tests --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:docker": "node tests/docker-smoke.mjs",
    "test:e2e": "playwright test",
    "test:acceptance": "node tests/docker-smoke.mjs --browser"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
